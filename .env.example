VITE_API_MODE=live
VITE_API_BASE_URL=/api

PORT=4000
WEB_PORT=8080
FRONTEND_ORIGIN=https://domains.example.com
DATABASE_URL=postgresql://whoischecker:GENERATE_A_STRONG_PASSWORD@localhost:5432/whoischecker
REDIS_URL=redis://:GENERATE_A_STRONG_PASSWORD@localhost:6379
POSTGRES_USER=whoischecker
POSTGRES_PASSWORD=GENERATE_A_STRONG_PASSWORD
REDIS_PASSWORD=GENERATE_A_DIFFERENT_STRONG_PASSWORD
POSTGRES_DB=whoischecker

JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SECRET_ENCRYPTION_KEY=GENERATE_EXACTLY_64_HEXADECIMAL_CHARACTERS
COOKIE_SECURE=true
TRUST_PROXY=1

ENABLE_EXTERNAL_DELIVERY=false
ENABLE_WORKERS=true
ENABLE_SCHEDULER=true
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_TIMEOUT_MS=5000
WHOIS_TIMEOUT_MS=5000
OPENPROVIDER_TIMEOUT_MS=10000
OPENPROVIDER_BASE_URL=https://api.openprovider.eu

ALLOW_DB_SEED=false
SEED_ALLOW_PRODUCTION=false
