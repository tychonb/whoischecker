{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022"
    ],
    "rootDir": "../..",
    "outDir": "dist",
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@whoischecker/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@whoischecker/shared/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src",
    "prisma"
  ]
}
